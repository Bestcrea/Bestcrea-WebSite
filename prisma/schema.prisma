// Bestcrea — Prisma schema
// Multilingual content fields use JSON: { fr, en, ar, es, de }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  editor
  client
  director
  gerant
  manager
  collaborateur
  prestataire
  assistant
}

enum LegalStatus {
  auto_entrepreneur
  sarl
  sarl_au
  sa
  association
  cooperative
  personne_physique
}

enum AccountStatus {
  active
  suspended
}

enum PublishStatus {
  draft
  published
  archived
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum QuoteStatus {
  draft
  sent
  viewed
  pending
  accepted
  rejected
  expired
  cancelled
}

enum QuoteRequestStatus {
  new
  in_review
  quoted
  closed
  cancelled
}

enum PurchaseOrderStatus {
  draft
  sent
  confirmed
  cancelled
}

enum DeliveryNoteStatus {
  draft
  sent
  delivered
  cancelled
}

enum OrderStatus {
  pending
  awaiting_payment
  payment_submitted
  payment_confirmed
  processing
  in_progress
  completed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  submitted
  confirmed
  failed
  refunded
}

enum PaymentMethod {
  bank_cih
  bank_albarid
  bank_chaabi
  ria
  western_union
  cash_plus
  paypal
}

enum DiscountType {
  percentage
  fixed
}

enum NotificationAudience {
  client
  staff
}

enum InvoiceStatus {
  draft
  sent
  unpaid
  partially_paid
  paid
  overdue
  cancelled
}

enum ProjectStatus {
  draft
  active
  on_hold
  completed
  cancelled
}

enum TicketStatus {
  open
  in_progress
  waiting
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String?
  name           String?
  role           UserRole      @default(client)
  image          String?
  phone          String?
  company        String?
  locale         String        @default("fr")
  emailVerified  DateTime?
  /// Unique internal client ID, e.g. CL-000123 (null for staff accounts)
  clientCode     String?       @unique
  firstName      String?
  lastName       String?
  address        String?
  city           String?
  ice            String?
  rc             String?
  legalStatus    LegalStatus?
  accountStatus  AccountStatus @default(active)
  lastActivityAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quoteRequests     QuoteRequest[]
  quotes            Quote[]
  purchaseOrders    PurchaseOrder[]
  deliveryNotes     DeliveryNote[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  confirmedPayments Payment[]          @relation("PaymentConfirmer")
  projects          Project[]          @relation("ClientProjects")
  assignedProjects  Project[]          @relation("AssignedProjects")
  invoices          Invoice[]
  blogPosts         BlogPost[]
  chatConversations ChatConversation[]
  supportTickets    SupportTicket[]    @relation("TicketRequester")
  assignedTickets   SupportTicket[]    @relation("TicketAssignee")
  testimonials      Testimonial[]

  @@index([role])
  @@index([accountStatus])
  @@index([city])
  @@map("users")
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  source    String?
  status    LeadStatus @default(new)
  locale    String     @default("fr")
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  quotes Quote[]

  @@index([email])
  @@index([status])
  @@map("leads")
}

model Quote {
  id                  String      @id @default(cuid())
  /// Sequential quote number, e.g. DEV-2026-0001
  reference           String      @unique
  title               String
  description         String?
  /// Legacy total (kept for backward compatibility). New code uses `total`.
  amount              Decimal     @default(0) @db.Decimal(12, 2)
  currency            String      @default("DH")
  status              QuoteStatus @default(draft)
  validUntil          DateTime?
  issueDate           DateTime    @default(now())
  /// Legacy JSON line items. New code uses QuoteItem rows.
  items               Json?
  notes               String?
  internalNotes       String?
  terms               String?
  subtotal            Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal     @default(0) @db.Decimal(12, 2)
  totalHt             Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal     @default(0) @db.Decimal(12, 2)
  total               Decimal     @default(0) @db.Decimal(12, 2)
  sentAt              DateTime?
  viewedAt            DateTime?
  respondedAt         DateTime?
  rejectionReason     String?
  modificationRequest String?
  leadId              String?
  userId              String?
  quoteRequestId      String?
  projectId           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  quoteRequest   QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines          QuoteItem[]
  purchaseOrders PurchaseOrder[]
  orders         Order[]
  invoices       Invoice[]

  @@index([leadId])
  @@index([userId])
  @@index([quoteRequestId])
  @@index([status])
  @@map("quotes")
}

model Invoice {
  id               String         @id @default(cuid())
  reference        String         @unique
  title            String
  description      String?
  amount           Decimal        @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal        @db.Decimal(12, 2)
  currency         String         @default("EUR")
  status           InvoiceStatus  @default(draft)
  issuedAt         DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  /// Legacy JSON line items. New code uses InvoiceItem rows.
  items            Json?
  notes            String?
  terms            String?
  discountTotal    Decimal        @default(0) @db.Decimal(12, 2)
  /// Sum of confirmed payments recorded against this invoice
  paidTotal        Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?
  paymentReference String?
  sentAt           DateTime?
  userId           String
  projectId        String?
  orderId          String?
  quoteId          String?
  purchaseOrderId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         InvoiceItem[]
  payments      Payment[]

  @@index([userId])
  @@index([projectId])
  @@index([orderId])
  @@index([quoteId])
  @@index([status])
  @@map("invoices")
}

model Project {
  id          String        @id @default(cuid())
  /// Multilingual: { fr, en, ar, es, de }
  title       Json
  /// Multilingual: { fr, en, ar, es, de }
  description Json?
  slug        String        @unique
  status      ProjectStatus @default(draft)
  /// 0–100 project completion
  progress    Int           @default(0)
  /// Milestones: [{ id, title, status: pending|in_progress|done, dueDate? }]
  milestones  Json?
  coverImage  String?
  gallery     Json?
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  clientId    String?
  assigneeId  String?
  serviceId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client   User?     @relation("ClientProjects", fields: [clientId], references: [id], onDelete: SetNull)
  assignee User?     @relation("AssignedProjects", fields: [assigneeId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  invoices Invoice[]
  quotes   Quote[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model Service {
  id             String   @id @default(cuid())
  /// Multilingual: { fr, en, ar, es, de }
  title          Json
  /// Multilingual: { fr, en, ar, es, de }
  description    Json?
  /// Multilingual short pitch: { fr, en, ar, es, de }
  excerpt        Json?
  slug           String   @unique
  icon           String?
  image          String?
  features       Json?
  /// Starting price (display only)
  price          Decimal? @db.Decimal(12, 2)
  /// Multilingual CTA label: { fr, en, ar, es, de }
  ctaLabel       Json?
  category       String?
  seoTitle       Json?
  seoDescription Json?
  ogImage        String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects          Project[]
  pricingPlans      PricingPlan[]
  quoteRequests     QuoteRequest[]
  packs             Pack[]
  portfolioProjects PortfolioProject[]

  @@index([isActive, sortOrder])
  @@map("services")
}

model PricingPlan {
  id             String   @id @default(cuid())
  /// Multilingual: { fr, en, ar, es, de }
  name           Json
  /// Multilingual: { fr, en, ar, es, de }
  description    Json?
  slug           String   @unique
  price          Decimal  @db.Decimal(12, 2)
  /// Struck-through list price
  originalPrice  Decimal? @db.Decimal(12, 2)
  currency       String   @default("DH")
  /// Amount saved vs originalPrice
  discountAmount Decimal? @db.Decimal(12, 2)
  billingPeriod  String   @default("month")
  /// Multilingual feature list: { fr: string[], en: string[], ... }
  features       Json?
  /// Multilingual CTA: { fr, en, ar, es, de }
  ctaLabel       Json?
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  serviceId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service    Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  coupons    Coupon[]

  @@index([serviceId])
  @@index([isActive, sortOrder])
  @@map("pricing_plans")
}

model BlogPost {
  id          String    @id @default(cuid())
  /// Multilingual: { fr, en, ar, es, de }
  title       Json
  /// Multilingual: { fr, en, ar, es, de }
  excerpt     Json?
  /// Multilingual: { fr, en, ar, es, de }
  content     Json
  slug        String    @unique
  coverImage  String?
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([isPublished])
  @@map("blog_posts")
}

model Testimonial {
  id         String   @id @default(cuid())
  /// Multilingual: { fr, en, ar, es, de }
  content    Json
  /// Multilingual role/title: { fr, en, ar, es, de }
  role       Json?
  authorName String
  company    String?
  avatar     String?
  rating     Int?     @default(5)
  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("testimonials")
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  /// Multilingual: { fr, en, ar, es, de }
  description Json?
  logo        String?
  website     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partners")
}

model PageContent {
  id             String   @id @default(cuid())
  /// Unique page key, e.g. "home", "about", "services"
  key            String   @unique
  /// Multilingual page title: { fr, en, ar, es, de }
  title          Json
  /// Multilingual SEO description: { fr, en, ar, es, de }
  seoDescription Json?
  /// Multilingual page body/sections payload: { fr, en, ar, es, de }
  content        Json
  isPublished    Boolean  @default(false)
  /// Public URL slug (defaults to key when null)
  slug           String?  @unique
  featuredImage  String?
  seoTitle       Json?
  ogTitle        Json?
  ogDescription  Json?
  ogImage        String?
  canonicalUrl   String?
  noindex        Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  menuItems MenuItem[]

  @@map("page_contents")
}

model ChatConversation {
  id             String    @id @default(cuid())
  subject        String?
  locale         String    @default("fr")
  status         String    @default("open")
  /// Array of messages: [{ role, content, createdAt }]
  messages       Json      @default("[]")
  metadata       Json?
  userId         String?
  guestEmail     String?
  guestName      String?
  /// True once the AI hands the conversation over to a human
  handoffToHuman Boolean   @default(false)
  handoffAt      DateTime?
  messageCount   Int       @default(0)
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  chatMessages AiMessage[]

  @@index([userId])
  @@index([status])
  @@index([lastActivityAt])
  @@map("chat_conversations")
}

model SupportTicket {
  id          String         @id @default(cuid())
  reference   String         @unique
  /// Multilingual subject optional; plain string for tickets
  subject     String
  description String
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(medium)
  locale      String         @default("fr")
  /// Thread messages: [{ authorId?, content, createdAt }]
  messages    Json           @default("[]")
  requesterId String?
  assigneeId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?

  requester User? @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee  User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([assigneeId])
  @@index([status])
  @@map("support_tickets")
}

// ─────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────

/// Configurable permissions per staff role. Permission keys are defined in lib/rbac.ts.
model RolePermission {
  id          String   @id @default(cuid())
  role        UserRole @unique
  permissions String[]
  updatedAt   DateTime @updatedAt

  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  /// Multilingual: { fr, en, ar, es, de }
  name             Json
  shortDescription Json?
  description      Json?
  coverImage       String?
  /// string[] of image URLs
  gallery          Json?
  price            Decimal       @db.Decimal(12, 2)
  promoPrice       Decimal?      @db.Decimal(12, 2)
  currency         String        @default("DH")
  /// Multilingual feature list: { fr: string[], ... }
  features         Json?
  category         String?
  status           PublishStatus @default(draft)
  isFeatured       Boolean       @default(false)
  seoTitle         Json?
  seoDescription   Json?
  ogImage          String?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  packs      Pack[]
  coupons    Coupon[]
  orderItems OrderItem[]

  @@index([status, sortOrder])
  @@map("products")
}

model Pack {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           Json
  description    Json?
  price          Decimal       @db.Decimal(12, 2)
  promoPrice     Decimal?      @db.Decimal(12, 2)
  currency       String        @default("DH")
  features       Json?
  /// Duration in days (null = one-off)
  durationDays   Int?
  badge          Json?
  isRecommended  Boolean       @default(false)
  ctaLabel       Json?
  status         PublishStatus @default(draft)
  sortOrder      Int           @default(0)
  seoTitle       Json?
  seoDescription Json?
  ogImage        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  services   Service[]
  products   Product[]
  coupons    Coupon[]
  orderItems OrderItem[]

  @@index([status, sortOrder])
  @@map("packs")
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  description      String?
  discountType     DiscountType
  /// Percentage (0-100) or fixed amount in currency
  value            Decimal      @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  minOrderAmount   Decimal?     @db.Decimal(12, 2)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  products    Product[]
  packs       Pack[]
  plans       PricingPlan[]
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────────────────────────────────────
// Sales workflow: QuoteRequest → Quote → PurchaseOrder → Order
//                 → Payment → DeliveryNote → Invoice
// ─────────────────────────────────────────────────────────────

model QuoteRequest {
  id              String             @id @default(cuid())
  /// Sequential number, e.g. DD-2026-0001
  number          String             @unique
  userId          String
  serviceId       String?
  title           String
  description     String
  quantity        Int?
  requirements    String?
  budget          String?
  desiredDeadline DateTime?
  notes           String?
  /// [{ url, name, size, type }]
  attachments     Json?
  status          QuoteRequestStatus @default(new)
  internalNotes   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  quotes  Quote[]

  @@index([userId])
  @@index([status])
  @@map("quote_requests")
}

model QuoteItem {
  id              String  @id @default(cuid())
  quoteId         String
  position        Int     @default(0)
  name            String
  description     String?
  quantity        Decimal @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(12, 2)
  /// Discount percentage on this line (0-100)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  /// VAT rate for this line, e.g. 20.00
  taxRate         Decimal @default(20) @db.Decimal(5, 2)
  /// Line total HT after discount
  lineTotal       Decimal @db.Decimal(12, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  /// Sequential number, e.g. BC-2026-0001
  number        String              @unique
  quoteId       String?
  userId        String
  status        PurchaseOrderStatus @default(draft)
  issueDate     DateTime            @default(now())
  currency      String              @default("DH")
  subtotal      Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal Decimal             @default(0) @db.Decimal(12, 2)
  totalHt       Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal             @default(0) @db.Decimal(12, 2)
  total         Decimal             @default(0) @db.Decimal(12, 2)
  terms         String?
  notes         String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  quote    Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines    PurchaseOrderItem[]
  orders   Order[]
  invoices Invoice[]

  @@index([quoteId])
  @@index([userId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  position        Int     @default(0)
  name            String
  description     String?
  quantity        Decimal @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(20) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Order {
  id              String         @id @default(cuid())
  /// Sequential number, e.g. CMD-2026-0001
  number          String         @unique
  userId          String
  status          OrderStatus    @default(pending)
  paymentStatus   PaymentStatus  @default(pending)
  paymentMethod   PaymentMethod?
  currency        String         @default("DH")
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  couponId        String?
  /// Snapshot of the coupon code at purchase time
  couponCode      String?
  quoteId         String?
  purchaseOrderId String?
  customerNotes   String?
  internalNotes   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon        Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  quote         Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  invoices      Invoice[]
  deliveryNotes DeliveryNote[]
  redemption    CouponRedemption?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  /// "plan" | "pack" | "product" | "service" | "custom"
  kind          String
  pricingPlanId String?
  packId        String?
  productId     String?
  /// Snapshots so historical orders never change when the catalogue does
  name          String
  description   String?
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pricingPlan PricingPlan? @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  pack        Pack?        @relation(fields: [packId], references: [id], onDelete: SetNull)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([pricingPlanId])
  @@index([packId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  invoiceId             String?
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("DH")
  /// Customer-submitted transfer / transaction reference
  reference             String?
  /// Uploaded proof of payment (stored privately, served via authorized route)
  proofPath             String?
  proofName             String?
  /// PayPal order/capture id etc. Unique to prevent replay of a confirmation.
  providerTransactionId String?       @unique
  providerPayload       Json?
  notes                 String?
  confirmedById         String?
  confirmedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  confirmedBy User?    @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model InvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  position        Int     @default(0)
  name            String
  description     String?
  quantity        Decimal @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(20) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model DeliveryNote {
  id          String             @id @default(cuid())
  /// Sequential number, e.g. BL-2026-0001
  number      String             @unique
  orderId     String
  userId      String
  status      DeliveryNoteStatus @default(draft)
  issueDate   DateTime           @default(now())
  deliveredAt DateTime?
  notes       String?
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  order Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines DeliveryNoteItem[]

  @@index([orderId])
  @@index([userId])
  @@map("delivery_notes")
}

model DeliveryNoteItem {
  id             String  @id @default(cuid())
  deliveryNoteId String
  position       Int     @default(0)
  name           String
  description    String?
  quantity       Decimal @default(1) @db.Decimal(12, 2)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_note_items")
}

/// Atomic sequential numbering per document type and year (key e.g. "DEV-2026").
model DocumentSequence {
  key       String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("document_sequences")
}

// ─────────────────────────────────────────────────────────────
// Notifications, audit, AI
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String               @id @default(cuid())
  audience  NotificationAudience
  /// Recipient for client notifications; null = all staff
  userId    String?
  /// e.g. quote.created, order.created, payment.confirmed
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([audience, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  /// e.g. quote.created, order.status_changed, role.permissions_changed
  action    String
  entity    String
  entityId  String?
  /// { before?, after? } or free-form diff
  changes   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// "user" | "assistant" | "human"
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ─────────────────────────────────────────────────────────────
// Website CMS
// ─────────────────────────────────────────────────────────────

model Language {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nativeName String
  isEnabled  Boolean  @default(true)
  isDefault  Boolean  @default(false)
  isRtl      Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("languages")
}

model MenuItem {
  id        String   @id @default(cuid())
  /// "main" | "footer-company" | "footer-legal" | …
  menu      String
  parentId  String?
  /// Multilingual label: { fr, en, ar, es, de }
  label     Json
  /// "page" | "internal" | "external"
  type      String   @default("internal")
  href      String?
  pageId    String?
  isEnabled Boolean  @default(true)
  newTab    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MenuItem?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[]   @relation("MenuTree")
  page     PageContent? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([menu, parentId, sortOrder])
  @@map("menu_items")
}

model PortfolioProject {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  client         String?
  category       String?
  description    Json?
  coverImage     String?
  gallery        Json?
  technologies   String[]
  url            String?
  completedAt    DateTime?
  isFeatured     Boolean       @default(false)
  status         PublishStatus @default(draft)
  sortOrder      Int           @default(0)
  seoTitle       Json?
  seoDescription Json?
  ogImage        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  services Service[]

  @@index([status, sortOrder])
  @@map("portfolio_projects")
}

/// Key/value global website settings (site name, VAT, SEO defaults, header/footer, …)
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
